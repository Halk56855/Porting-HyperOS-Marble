#!/sbin/sh
# =============================================================================
#  update-binary - HyperOS port @PORT_VERSION@ untuk @TARGET_DEVICE@
#  Disesuaikan untuk Samsung Galaxy A04 (mendukung layout non-A/B maupun A/B)
# =============================================================================
OUTFD=/proc/self/fd/$2
ZIPFILE=$3

TARGET="@TARGET_DEVICE@"
PORT_VERSION="@PORT_VERSION@"
ANTI_VER="@ANTI_VER@"
SUPER_FORMAT="@SUPER_FORMAT@"
SUPER_BYTES="@SUPER_BYTES@"
FLASH_RECOVERY="@FLASH_RECOVERY@"
AB_IMAGES="@AB_IMAGES@"
NONAB_IMAGES="@NONAB_IMAGES@"
TMPD=/tmp/hyperos_port
ERRF=$TMPD/err

ui_print() {
    echo "ui_print $1" >> "$OUTFD"
    echo "ui_print" >> "$OUTFD"
}

progress() {
    echo "set_progress $1" >> "$OUTFD"
}

abort() {
    ui_print "! $1"
    ui_print "! تم إلغاء التفليش."
    exit 1
}

# البحث عن عقدة القسم في /dev/block/by-name أو /dev/block/platform/**/by-name
find_by_name_dir() {
    if [ -d "/dev/block/by-name" ]; then
        echo "/dev/block/by-name"
        return 0
    fi
    if [ -d "/dev/block/bootdevice/by-name" ]; then
        echo "/dev/block/bootdevice/by-name"
        return 0
    fi
    for d in /dev/block/platform/*/by-name /dev/block/platform/*/*/by-name; do
        if [ -d "$d" ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# تفليش ملف من داخل ZIP إلى مسار كتلة محدد
write_to_dev() { # zip_entry dev_path
    entry=$1
    dev=$2
    unzip -l "$ZIPFILE" "$entry" >/dev/null 2>&1 || return 0
    [ -e "$dev" ] || { ui_print "  - تخطي $entry (القسم غير موجود)"; return 0; }
    rm -f "$ERRF"
    { unzip -p "$ZIPFILE" "$entry" || echo "unzip" >> "$ERRF"; } | \
        { dd of="$dev" bs=1048576 2>/dev/null || echo "dd" >> "$ERRF"; }
    [ -f "$ERRF" ] && abort "فشل كتابة $entry إلى $dev ($(tr '\n' ' ' < "$ERRF"))"
    return 0
}

# تفليش قسم يدعم الشكل المباشر (A04) أو الشكل المزدوج (_a/_b)
flash_partition_smart() { # part_name
    part=$1
    if [ "$part" = "recovery" ] && [ "$FLASH_RECOVERY" != "true" ]; then
        ui_print "  - تخطي recovery (الريكفري الحالي محفوظ)"
        return 0
    fi
    if [ -e "$BLK/$part" ]; then
        ui_print "  - تفليش $part"
        write_to_dev "images/$part.img" "$BLK/$part"
        return 0
    fi
    flashed_any=0
    for sfx in _a _b; do
        if [ -e "$BLK/${part}${sfx}" ]; then
            ui_print "  - تفليش ${part}${sfx}"
            write_to_dev "images/$part.img" "$BLK/${part}${sfx}"
            flashed_any=1
        fi
    done
    if [ "$flashed_any" -eq 0 ]; then
        ui_print "  - تخطي $part (غير موجود في الجهاز)"
    fi
}

write_super() {
    rm -f "$ERRF"
    if [ "$SUPER_FORMAT" = "zst" ]; then
        { unzip -p "$ZIPFILE" images/super.img.zst || echo "unzip" >> "$ERRF"; } | \
            { "$TMPD/zstd" -dc || echo "zstd" >> "$ERRF"; } | \
            { dd of="$BLK/super" bs=4194304 2>/dev/null || echo "dd" >> "$ERRF"; }
    else
        { unzip -p "$ZIPFILE" images/super.img || echo "unzip" >> "$ERRF"; } | \
            { dd of="$BLK/super" bs=4194304 2>/dev/null || echo "dd" >> "$ERRF"; }
    fi
    [ -f "$ERRF" ] && abort "فشل كتابة super ($(tr '\n' ' ' < "$ERRF"))"
    return 0
}

# ------------------------------------------------------------------ البدء
mkdir -p "$TMPD"
ui_print " "
ui_print "=========================================="
ui_print " HyperOS $PORT_VERSION"
ui_print " Port للجهاز: $TARGET (Samsung Galaxy A04)"
[ -n "@ROM_AUTHOR@" ] && ui_print " بواسطة: @ROM_AUTHOR@"
ui_print "=========================================="
ui_print " "

BLK=$(find_by_name_dir) || abort "تعذر العثور على مجلد by-name"
ui_print "- مسار الأقسام: $BLK"

# التحقق من اسم الجهاز عبر عدة خصائص
dev_ok=0
target_lc=$(printf '%s' "$TARGET" | tr '[:upper:]' '[:lower:]')
for prop in ro.product.device ro.product.vendor.device ro.product.system.device ro.product.model ro.build.product; do
    val=$(getprop "$prop" 2>/dev/null | tr '[:upper:]' '[:lower:]')
    [ -z "$val" ] && continue
    case "$val" in
        "$target_lc"|*"$target_lc"*|a04*) dev_ok=1 ;;
    esac
done
if [ "$dev_ok" -ne 1 ]; then
    ui_print "! تحذير: خاصية الجهاز الحالية ($(getprop ro.product.device)) لا تطابق $TARGET صراحةً، متابعة بحذر..."
fi

# التحقق من وجود قسم super ومطابقة حجمه
[ -e "$BLK/super" ] || abort "قسم super غير موجود في $BLK"
if command -v blockdev >/dev/null 2>&1; then
    real=$(blockdev --getsize64 "$BLK/super" 2>/dev/null || true)
    if [ -n "$real" ] && [ -n "$SUPER_BYTES" ] && [ "$SUPER_BYTES" != "auto" ]; then
        if [ "$real" != "$SUPER_BYTES" ]; then
            ui_print "! حجم super في الجهاز: $real بايت"
            ui_print "! حجم super في الحزمة: $SUPER_BYTES بايت"
            abort "عدم تطابق حجم super. أعد البناء بالقيمة: super_size=$real"
        fi
        ui_print "- حجم super مطابق ($real بايت)"
    fi
fi

# التحقق من وجود صورة super داخل ملف ZIP
unzip -l "$ZIPFILE" images/super.img images/super.img.zst 2>/dev/null | grep -q "images/super" \
    || abort "ملف images/super غير موجود داخل الحزمة"

if [ -n "$ANTI_VER" ]; then
    ui_print "- مستوى الحماية (ANTI_VER) في الحزمة: $ANTI_VER"
fi

if [ "$SUPER_FORMAT" = "zst" ]; then
    unzip -o "$ZIPFILE" META-INF/zstd -d "$TMPD" >/dev/null 2>&1
    mv -f "$TMPD/META-INF/zstd" "$TMPD/zstd" 2>/dev/null
    chmod 0755 "$TMPD/zstd"
    [ -x "$TMPD/zstd" ] || abort "فشل استخراج أداة zstd"
fi

# فك وصل أقسام النظام إن كانت موصولة في الريكفري
for m in /system_root /system /system_ext /product /vendor /odm /mi_ext /vendor_dlkm /system_dlkm /odm_dlkm; do
    umount "$m" >/dev/null 2>&1 || true
done

progress 0.05
ui_print "- تفليش أقسام التمهيد والملحقات..."
for p in $NONAB_IMAGES $AB_IMAGES; do
    [ -n "$p" ] || continue
    flash_partition_smart "$p"
done

progress 0.30
ui_print "- تفليش قسم super (قد يستغرق وقتًا، لا تفصل الكابل)..."
write_super
progress 0.90

# إعادة ربط الأقسام المنطقية في device-mapper إن توفر dmctl أو lptools
if command -v dmctl >/dev/null 2>&1; then
    for lp in system system_ext product vendor odm mi_ext vendor_dlkm system_dlkm odm_dlkm; do
        if [ -e "/dev/block/mapper/$lp" ]; then
            dmctl delete "$lp" >/dev/null 2>&1 || true
            dmctl create "$lp" >/dev/null 2>&1 || true
        fi
    done
elif command -v lptools >/dev/null 2>&1; then
    for lp in system system_ext product vendor odm mi_ext vendor_dlkm system_dlkm odm_dlkm; do
        if [ -e "/dev/block/mapper/$lp" ]; then
            lptools unmap "$lp" >/dev/null 2>&1 || true
            lptools map "$lp" >/dev/null 2>&1 || true
        fi
    done
fi

progress 1.0
rm -rf "$TMPD"
ui_print " "
ui_print "=========================================="
ui_print " اكتمل التفليش! اختر Reboot System الآن"
ui_print "=========================================="
exit 0
